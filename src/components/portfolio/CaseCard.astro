---
// Card del index (BRAND.md): uniforme — sin badge de estado, sin penalización.
// Promete "ver el caso", nunca "ver en vivo". La imagen lleva el transition:name
// que hace el morph card→hero.
import { Image } from 'astro:assets';
import type { CaseStudy } from '../../data/case-studies';
import { caseUrl } from '../../data/case-seo';
import { useTranslations } from '../../i18n/ui';

interface Props {
  cs: CaseStudy;
  lang: 'es' | 'en';
}

const { cs, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="group pf-card" data-category={cs.category}>
  <a href={caseUrl(cs, lang)} class="block">
    <div
      class="relative mb-6 aspect-[16/10] overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 transition-shadow duration-500 group-hover:shadow-2xl"
      transition:name={`pf-${cs.slug}`}
    >
      <Image
        src={cs.cardImage}
        alt={`${cs.title} — ${cs.services[lang]}`}
        widths={[480, 800]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 400px"
        class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </div>

    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="mb-1 font-mono text-[11px] uppercase tracking-widest text-pf-accent">
          {t(`pf.filter.${cs.category}`)}
        </p>
        <h3 class="font-display text-xl font-bold tracking-tight transition-colors group-hover:text-hikevo-yellow md:text-2xl lg:text-xl">
          {cs.title}
        </h3>
        <p class="mt-1 text-sm text-pf-ink-soft">{cs.services[lang]}</p>
      </div>
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-pf-line transition-all group-hover:border-hikevo-yellow group-hover:bg-hikevo-yellow"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-pf-ink transition-colors group-hover:text-hikevo-black"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>
    <span class="sr-only">{t('pf.card.view')}: {cs.title}</span>
  </a>
</article>
