---
// Capítulo de superficie (BRAND.md): sección numerada en el flujo de scroll —
// label mono, nombre, acceso y un slot para capturas/prosa. Nunca tabs.
import type { Surface } from '../../data/case-studies';
import { useTranslations } from '../../i18n/ui';

interface Props {
  surface: Surface;
  index: number; // 1-based
  lang: 'es' | 'en';
}

const { surface, index, lang } = Astro.props;
const t = useTranslations(lang);
const host = surface.url?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section id={`surface-${index}`} class="scroll-mt-28 py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6 md:px-12">
    <header class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-2 reveal-smooth">
      <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
      <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
        {surface.name[lang]}
      </h2>
      {
        surface.access === 'private' ? (
          <span class="font-mono text-xs uppercase tracking-widest text-pf-ink-soft">
            {t('pf.access.private')}
          </span>
        ) : (
          host && (
            <a
              href={surface.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs text-pf-accent underline decoration-pf-line underline-offset-4 hover:decoration-pf-accent"
            >
              {host}
            </a>
          )
        )
      }
    </header>
    <slot />
  </div>
</section>
