---
import Container from '../ui/Container.astro';
import Button from './Button.astro';
import { useTranslations } from '../../i18n/ui';

const currentLang = Astro.currentLocale || 'es';
const t = useTranslations(currentLang as any);

// 1. DEFINICIÓN DE RUTAS (Mejora de UX)
// Mapeamos las páginas de Español a sus equivalentes en Inglés
const routeMap = [
  { es: '/', en: '/en' },
  { es: '/soluciones', en: '/en/solutions' },
  { es: '/portafolio', en: '/en/portfolio' },
  { es: '/nosotros', en: '/en/about' },
  { es: '/contacto', en: '/en/contact' }, // Asumiendo que crearás contacto
  { es: '/privacidad', en: '/en/privacy' },
  { es: '/terminos', en: '/en/terms' }
];

// 2. LÓGICA PARA CALCULAR LA RUTA TRADUCIDA
// Obtenemos la ruta actual limpia (sin slash final para facilitar la comparación)
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

let targetEs = '/';
let targetEn = '/en';

// Buscamos si la página actual está en nuestro mapa
const match = routeMap.find(r => 
    (currentLang === 'es' && r.es === currentPath) || 
    (currentLang === 'en' && r.en === currentPath)
);

if (match) {
    targetEs = match.es;
    targetEn = match.en;
} else {
    // FALLBACK INTELIGENTE PARA RUTAS DINÁMICAS (Ej: Proyectos de portafolio)
    // Si estamos en un proyecto, intentamos redirigir al portafolio principal del otro idioma
    // porque no sabemos la traducción exacta del slug del proyecto.
    if (currentPath.includes('/portafolio/')) targetEn = '/en/portfolio';
    if (currentPath.includes('/portfolio/')) targetEs = '/portafolio';
}

// 3. ITEMS DEL MENÚ DE NAVEGACIÓN
const navItems = [
  { 
    label: t('nav.solutions'), 
    href: currentLang === 'es' ? '/soluciones' : '/en/solutions' 
  },
  { 
    label: t('nav.portfolio'), 
    href: currentLang === 'es' ? '/portafolio' : '/en/portfolio'
  },
  { 
    label: t('nav.about'), 
    href: currentLang === 'es' ? '/nosotros' : '/en/about'
  },
];

const homeUrl = currentLang === 'es' ? '/' : '/en';
---

<header class="fixed top-0 w-full z-50 transition-all duration-300 bg-white border-b border-gray-100" id="main-header">
  <Container>
    <div class="flex items-center justify-between h-20">
      
      <a href={homeUrl} class="flex items-center gap-2 group relative z-50">
        <img 
          src="/logo.svg" 
          alt="Logo Hikevo Design" 
          width="120" 
          height="40"
          class="h-8 w-auto transition-transform duration-300 group-hover:scale-105" 
        />
      </a>

      <nav class="hidden md:flex items-center gap-8">
        {navItems.map(item => (
          <a 
      href={item.href} 
      class="relative group text-sm font-medium text-hikevo-charcoal hover:text-hikevo-black transition-colors duration-300"
    >
      {item.label}
      <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-hikevo-yellow transition-all duration-300 ease-out group-hover:w-full"></span>
    </a>
        ))}
      </nav>

      <div class="flex items-center gap-4 relative z-50">
        
        <div class="hidden md:flex gap-2 text-xs font-bold mr-2">
            <a href={targetEs} class={currentLang === 'es' ? 'text-hikevo-black pointer-events-none' : 'text-gray-500 hover:text-hikevo-black transition-colors'}>
                ES
            </a>
            <span class="text-gray-300">|</span>
            <a href={targetEn} class={currentLang === 'en' ? 'text-hikevo-black pointer-events-none' : 'text-gray-500 hover:text-hikevo-black transition-colors'}>
                EN
            </a>
        </div>

        <div class="hidden md:block">
          <Button
            href={currentLang === 'es' 
                ? "https://wa.me/17866692775?text=%C2%A1Hola!%20Me%20gustar%C3%ADa%20conversar%20sobre%20c%C3%B3mo%20podemos%20mejorar%20mi%20negocio."
                : "https://wa.me/17866692775?text=Hello!%20I%20would%20like%20to%20talk%20about%20improving%20my%20business."}
            variant="primary"
            isExternal={true}
          >
            {t('btn.talk')}
          </Button>
        </div>
        
        <button id="menu-toggle" class="md:hidden p-2 text-hikevo-black focus:outline-none focus:ring-2 focus:ring-hikevo-yellow rounded-lg transition-colors" aria-label="Alternar menú">
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 hidden transition-transform duration-300 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </Container>

  <div id="mobile-menu" class="fixed inset-0 z-40 bg-white flex flex-col justify-start pt-32 items-center gap-8 translate-x-full transition-transform duration-300 ease-in-out md:hidden">
    <nav class="flex flex-col items-center gap-8 w-full">
      {navItems.map(item => (
        <a href={item.href} class="text-2xl font-bold text-hikevo-black hover:text-hikevo-yellow transition-colors mobile-link w-full text-center py-2">
          {item.label}
        </a>
      ))}
      
      <div class="flex gap-4 text-xl font-bold mt-4">
            <a href={targetEs} class={currentLang === 'es' ? 'text-hikevo-black pointer-events-none' : 'text-gray-500'}>ES</a>
            <span class="text-gray-300">|</span>
            <a href={targetEn} class={currentLang === 'en' ? 'text-hikevo-black pointer-events-none' : 'text-gray-500'}>EN</a>
      </div>
    </nav>
    
    <div class="mt-4">
       <Button
            href="https://wa.me/17866692775"
            variant="primary"
            isExternal={true}
            class="mobile-link text-lg px-8 py-3"
          >
            {t('btn.talk')}
          </Button>
    </div>
  </div>
</header>

<script is:inline>
  function initMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.getElementById('main-header');
    
    if (!toggleBtn || !mobileMenu) return;

    // Clonamos para limpiar eventos anteriores y evitar duplicados al navegar
    const newBtn = toggleBtn.cloneNode(true);
    toggleBtn.parentNode.replaceChild(newBtn, toggleBtn);
    
    const iconOpen = newBtn.querySelector('#icon-open');
    const iconClose = newBtn.querySelector('#icon-close');

    let isMenuOpen = false;

    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        mobileMenu.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden'; 
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        iconClose?.classList.remove('rotate-90');
      } else {
        mobileMenu.classList.add('translate-x-full');
        document.body.style.overflow = '';
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        iconClose?.classList.add('rotate-90');
      }
      newBtn.setAttribute('aria-expanded', isMenuOpen.toString());
    };

    newBtn.addEventListener('click', toggleMenu);

    // Cerrar al hacer click en links
    const mobileLinks = document.querySelectorAll('.mobile-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });

    // Efecto de sombra en scroll
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header?.classList.add('shadow-md');
      } else {
        header?.classList.remove('shadow-md');
      }
    });
  }

  // Inicializar en carga y en navegación de Astro (ViewTransitions)
  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>