---
// Importamos la fuente Inter
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/900.css';

// 1. IMPORTANTE: Importamos los estilos globales
import '../styles/global.css'; 

import { ClientRouter } from 'astro:transitions';
// Importamos el Footer
import Footer from '../components/common/Footer.astro';
import WhatsAppSticky from '../components/common/WhatsAppSticky.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { 
	title, 
	description, 
	image = "/open-graph.png" 
} = Astro.props;

// Obtener el idioma actual
const currentLang = Astro.currentLocale || 'es';

// Definir URL base y canónica
const siteUrl = Astro.site ?? "https://hikevodesign.com";
const absoluteImageUrl = new URL(image, siteUrl).toString();
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// --- LÓGICA SEO INTERNACIONAL (HREFLANG) ---
// 1. Mapa de rutas equivalentes (Misma lógica que en el Header)
const routeMap = [
  { es: '/', en: '/en' },
  { es: '/soluciones', en: '/en/solutions' },
  { es: '/portafolio', en: '/en/portfolio' },
  { es: '/nosotros', en: '/en/about' },
  { es: '/contacto', en: '/en/contact' },
  { es: '/privacidad', en: '/en/privacy' },
  { es: '/terminos', en: '/en/terms' }
];

// 2. Determinar las URLs para cada idioma
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
let esPath = '/';
let enPath = '/en';

// Buscamos si la página actual tiene una traducción exacta definida
const match = routeMap.find(r => r.es === currentPath || r.en === currentPath);

if (match) {
    esPath = match.es;
    enPath = match.en;
} else {
    // Fallback para rutas dinámicas (como proyectos de portafolio)
    // Si estamos dentro de portafolio, apuntamos a la página principal del portafolio en el otro idioma
    // para evitar errores 404 en las etiquetas meta.
    if (currentPath.includes('/portafolio/') || currentPath.includes('/portfolio/')) {
        esPath = '/portafolio';
        enPath = '/en/portfolio';
    }
}

const esUrl = new URL(esPath, siteUrl).toString();
const enUrl = new URL(enPath, siteUrl).toString();
// ---------------------------------------------
const ogLocale = currentLang === 'es' ? 'es_US' : 'en_US';
const ogLocaleAlternate = currentLang === 'es' ? 'en_US' : 'es_US';

// LÓGICA DE SCHEMA DINÁMICA
const schemaDescription = currentLang === 'es' 
  ? "Agencia de desarrollo web y marketing digital internacional. 100% Remoto."
  : "International web development and digital marketing agency. 100% Remote.";
  
const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Hikevo Design",
  "image": "https://hikevodesign.com/logo.svg",
  "url": "https://hikevodesign.com",
  "priceRange": "$$$",
  "address": { "@type": "PostalAddress", "addressCountry": "VE" },
  "areaServed": ["US", "ES", "MX", "Latin America"],
  "description": schemaDescription
});
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
	<head>
		<ClientRouter />
		
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="facebook-domain-verification" content="u1dvftzh1ha1j18l0uvgb1eckfcaxf" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />

		<link 
          rel="preload" 
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
          as="style" 
          onload="this.onload=null;this.rel='stylesheet'" 
          crossorigin="anonymous" 
          referrerpolicy="no-referrer"
        />

        <noscript>
            <link 
              rel="stylesheet" 
              href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
              integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" 
              crossorigin="anonymous" 
              referrerpolicy="no-referrer" 
            />
        </noscript>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageUrl} />

		<meta property="og:site_name" content="Hikevo Design" />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={absoluteImageUrl} />

		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>

		<script is:inline>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1895489631086438');
        fbq('track', 'PageView');
        </script>
        <script type="application/ld+json" set:html={organizationSchema} />
		
		<slot name="head" />
	</head>
	<body class="bg-white text-hikevo-black font-sans antialiased selection:bg-hikevo-yellow selection:text-black flex flex-col min-h-screen">
		<noscript><img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1895489631086438&ev=PageView&noscript=1"
        /></noscript>

		<div class="flex-grow">
			<slot />
		</div>

		<Footer />
		<WhatsAppSticky />

		<script>
			// Función para inicializar el observador de animaciones
			const initAnimations = () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px', 
					threshold: 0.1 // 10% visible para activar
				};

				const observer = new IntersectionObserver((entries, observer) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				}, observerOptions);

				// Seleccionar todos los elementos con la clase .reveal-smooth
				const elements = document.querySelectorAll('.reveal-smooth');
				elements.forEach(el => observer.observe(el));
			};

			// Ejecutar al cargar la página inicialmente
			document.addEventListener('DOMContentLoaded', initAnimations);
			
			// Ejecutar en cada navegación subsiguiente (gracias a ClientRouter)
			document.addEventListener('astro:page-load', initAnimations);
		</script>
	</body>
</html>

<style is:global>
	body {
		overflow-x: hidden;
	}
	h1, h2, h3, h4, h5, h6 {
		letter-spacing: -0.025em; 
	}
</style>