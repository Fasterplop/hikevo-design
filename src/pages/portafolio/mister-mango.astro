---
// Case study: Mister Mango (ES) — social media, contenido vertical.
// Página libre (ADR-0001): hechos del registro, prosa y arte aquí.
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../components/portfolio/CaseHero.astro';
import FactBar from '../../components/portfolio/FactBar.astro';
import OutcomeTiles from '../../components/portfolio/OutcomeTiles.astro';
import Lightbox from '../../components/portfolio/Lightbox.astro';
import TestimonialQuote from '../../components/portfolio/TestimonialQuote.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../data/case-studies';
import { buildCaseSeo } from '../../data/case-seo';

import mobile from '../../assets/images/projects/mistermango/mistermango-mobile.png';
import featured from '../../assets/images/projects/mistermango/mistermango-featured.png';

const cs = getCaseStudy('mister-mango');
const seo = await buildCaseSeo(cs, 'es');

// El feed desktop completo es el hero (cardImage); aquí van las dos piezas
// cuadradas — mismo ratio, fila alineada sin recorte.
const feed = [
  { src: mobile, alt: 'Contenido vertical de Mister Mango' },
  { src: featured, alt: 'Pieza destacada de la estrategia visual' },
];
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="es" />
      <FactBar cs={cs} lang="es" />

      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-3xl px-6 md:px-12">
          <div class="reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">El Desafío</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Que la foto haga agua la boca — y que el antojo tenga botón.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              El desafío era doble: primero, lograr que una foto transmitiera la acidez y
              frescura del producto. Segundo, capturar a ese cliente antojado que, aunque
              amaba el producto, no siempre tenía tiempo para desplazarse físicamente
              hasta el kiosko.
            </p>
          </div>
          <div class="mt-14 reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">La Solución</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Del "qué rico se ve" al pedido por DoorDash.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Diseñamos una estrategia visual de "food porn" para activar el deseo
              inmediato, y canalizamos ese antojo facilitando la acción: si no puedes
              venir al kiosko, un clic en la bio convierte el impulso en un pedido
              directo por DoorDash.
            </p>
          </div>
        </div>
      </section>

      <!-- El contenido: dos piezas cuadradas del feed -->
      <section class="pb-20 md:pb-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {
              feed.map((f, i) => (
                <button
                  type="button"
                  data-lightbox
                  aria-label="Ampliar imagen"
                  class:list={[
                    'group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth',
                    i === 1 && 'delay-150',
                  ]}
                >
                  <Image
                    src={f.src}
                    alt={f.alt}
                    widths={[720, 1600]}
                    sizes="(max-width: 640px) 100vw, 550px"
                    class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <OutcomeTiles outcomes={cs.outcomes} lang="es" />

      <TestimonialQuote
        quote={'La gente llega al kiosko mostrándome los videos de TikTok y pidiendo "ese mismo mango que vi en Instagram".\nLas redes realmente nos trajeron gente nueva.'}
        author="Mateo L., Fundador"
      />

      <CaseCta lang="es" />
      <Lightbox lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
