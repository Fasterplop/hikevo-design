---
// Case study: Lucky Pet Tag (ES) — ecosistema de 3 superficies.
// Página libre (ADR-0001): hechos del registro, prosa y arte aquí.
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../components/portfolio/CaseHero.astro';
import FactBar from '../../components/portfolio/FactBar.astro';
import AnchorChips from '../../components/portfolio/AnchorChips.astro';
import SurfaceChapter from '../../components/portfolio/SurfaceChapter.astro';
import OutcomeTiles from '../../components/portfolio/OutcomeTiles.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../data/case-studies';
import { buildCaseSeo } from '../../data/case-seo';

import publicProfile from '../../assets/images/projects/lucky-pet-tag/public-profile.png';
import ownerPortal from '../../assets/images/projects/lucky-pet-tag/owner-portal.png';
import admin1 from '../../assets/images/projects/lucky-pet-tag/admin-1.png';
import admin2 from '../../assets/images/projects/lucky-pet-tag/admin-2.png';

const cs = getCaseStudy('lucky-pet-tag');
const seo = await buildCaseSeo(cs, 'es');
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="es" />
      <FactBar cs={cs} lang="es" />
      <div class="pt-10">
        <AnchorChips surfaces={cs.surfaces} lang="es" />
      </div>

      <!-- Narrativa: una sola columna, tono de historia -->
      <section class="py-16 md:py-24">
        <div class="mx-auto max-w-3xl px-6 md:px-12">
          <div class="reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">El Desafío</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Una placa QR solo vale si el perfil detrás existe solo.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Lucky Pet Tag vende placas con código QR en su tienda Shopify. El problema
              era todo lo que pasaba después de la compra: crear el perfil de cada
              mascota, validar que solo el dueño legítimo pudiera editarlo, y servir una
              vista pública instantánea cuando alguien escanea la placa de una mascota
              perdida.
            </p>
          </div>
          <div class="mt-14 reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">La Solución</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Cada compra genera su perfil. Nadie toca nada.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Conectamos las órdenes de Shopify a un ecosistema propio en tres
              superficies: la compra dispara el identificador único, el perfil de la
              mascota y su código QR — generado por el propio sistema, listo para que el
              equipo de Lucky Pet Tag imprima la placa. El dueño se autentica con el
              correo de su compra para gestionar el perfil, y el escaneo del QR abre una
              vista pública optimizada para el celular de quien encontró a la mascota —
              con WhatsApp directo al dueño y envío de ubicación.
            </p>
          </div>
        </div>
      </section>

      <!-- Superficie 1: Vista pública QR (imagen vertical de teléfono) -->
      <SurfaceChapter surface={cs.surfaces![0]} index={1} lang="es">
        <div class="grid items-center gap-10 md:grid-cols-5">
          <figure class="mx-auto w-full max-w-[300px] overflow-hidden rounded-3xl border border-pf-line bg-pf-surface-2 shadow-xl md:col-span-2 reveal-smooth">
            <Image
              src={publicProfile}
              alt="Vista pública del perfil de mascota al escanear el QR"
              widths={[360, 600]}
              sizes="300px"
              class="h-auto w-full"
            />
          </figure>
          <div class="md:col-span-3 reveal-smooth delay-150">
            <p class="text-lg leading-relaxed text-pf-ink-soft">
              Solo lectura, carga instantánea y pensada para una situación de estrés:
              nombre de la mascota, descripción, botón de WhatsApp al dueño y envío de la
              ubicación actual en un toque. Sin apps, sin registro para quien escanea.
            </p>
          </div>
        </div>
      </SurfaceChapter>

      <!-- Superficie 2: Portal del dueño -->
      <SurfaceChapter surface={cs.surfaces![1]} index={2} lang="es">
        <figure class="overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg reveal-smooth">
          <Image
            src={ownerPortal}
            alt="Portal privado del dueño para gestionar el perfil de su mascota"
            widths={[720, 1400]}
            sizes="(max-width: 768px) 100vw, 1100px"
            class="h-auto w-full"
          />
        </figure>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          Login seguro vinculado al correo de la compra. El dueño actualiza foto,
          descripción, contacto y dirección — la identidad visual replica exactamente la
          tienda para que todo se sienta un solo producto.
        </p>
      </SurfaceChapter>

      <!-- Superficie 3: Panel administrativo -->
      <SurfaceChapter surface={cs.surfaces![2]} index={3} lang="es">
        <div class="grid gap-6 md:grid-cols-2">
          <figure class="overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg reveal-smooth">
            <Image
              src={admin1}
              alt="Panel administrativo: listado de clientes y mascotas"
              widths={[600, 1000]}
              sizes="(max-width: 768px) 100vw, 550px"
              class="h-auto w-full"
            />
          </figure>
          <figure class="overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg reveal-smooth delay-150">
            <Image
              src={admin2}
              alt="Panel administrativo: herramientas de soporte y accesos"
              widths={[600, 1000]}
              sizes="(max-width: 768px) 100vw, 550px"
              class="h-auto w-full"
            />
          </figure>
        </div>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          Control total del sistema: base de datos de clientes y mascotas, invitaciones
          por correo para colaboradores aprobados, y los códigos QR de cada placa
          generados automáticamente — listos para descargar e imprimir, con registro de
          cuáles ya fueron impresas.
        </p>
      </SurfaceChapter>

      <OutcomeTiles outcomes={cs.outcomes} lang="es" />

      <CaseCta lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
