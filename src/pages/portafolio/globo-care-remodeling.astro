---
// Case study: Globo Care Remodeling (ES) — sitio bilingüe de servicios.
// Página libre (ADR-0001): hechos del registro, prosa y arte aquí.
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../components/portfolio/CaseHero.astro';
import FactBar from '../../components/portfolio/FactBar.astro';
import OutcomeTiles from '../../components/portfolio/OutcomeTiles.astro';
import Lightbox from '../../components/portfolio/Lightbox.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../data/case-studies';
import { buildCaseSeo } from '../../data/case-seo';

// Capturas de cada subpágina recortadas DESDE DEBAJO del hero (ventana 4:3):
// se ve el contenido real de cada página, no cuatro banners repetidos.
import services from '../../assets/images/projects/globo-care-remodeling/services-below.png';
import galleryShot from '../../assets/images/projects/globo-care-remodeling/gallery-below.png';
import about from '../../assets/images/projects/globo-care-remodeling/about-below.png';
import contact from '../../assets/images/projects/globo-care-remodeling/contact-below.png';

const cs = getCaseStudy('globo-care-remodeling');
const seo = await buildCaseSeo(cs, 'es');

const work = [
  { src: services, alt: 'Páginas de servicios optimizadas para Google' },
  { src: galleryShot, alt: 'Galería de trabajos con filtro por tipo' },
  { src: about, alt: 'Página Sobre Nosotros con enfoque local en Sarasota' },
  { src: contact, alt: 'Formulario de contacto que califica al cliente' },
];
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="es" />
      <FactBar cs={cs} lang="es" />

      <!-- Narrativa en columna ancha, tono comercial local -->
      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-3xl px-6 md:px-12">
          <div class="reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">El Desafío</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Competir en Sarasota exige hablar dos idiomas y cargar rápido.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Globo Care necesitaba posicionarse como líder de remodelación en un mercado
              donde el cliente busca en Google, compara en minutos y habla inglés o
              español. Sin sitio propio, cada lead dependía del boca a boca — y el valor
              de sus transformaciones no se veía en ninguna parte.
            </p>
          </div>
          <div class="mt-14 reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">La Solución</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Un sitio que muestra el antes y después — y califica al lead.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Sitio multipágina bilingüe con SEO local para Sarasota: páginas
              individuales por servicio, galería filtrable por tipo de trabajo, un
              deslizador "Antes y Después" para que el valor se vea, y un formulario
              inteligente que clasifica al cliente según lo que necesita. Servido sobre
              Cloudflare aprovechando el hosting que el cliente ya pagaba.
            </p>
          </div>
        </div>
      </section>

      <!-- La obra -->
      <section class="pb-20 md:pb-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid gap-6 md:grid-cols-2">
            {
              work.map((w, i) => (
                <button
                  type="button"
                  data-lightbox
                  aria-label="Ampliar imagen"
                  class:list={[
                    'group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth',
                    i % 2 === 1 && 'delay-150',
                  ]}
                >
                  <Image
                    src={w.src}
                    alt={w.alt}
                    widths={[720, 1600]}
                    sizes="(max-width: 768px) 100vw, 550px"
                    class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <OutcomeTiles outcomes={cs.outcomes} lang="es" />

      <CaseCta lang="es" />
      <Lightbox lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
