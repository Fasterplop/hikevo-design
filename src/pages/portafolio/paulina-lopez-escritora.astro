---
// Case study: Paulina López (ES) — web a medida con sistema de marketing.
// Página libre (ADR-0001): hechos del registro, prosa y arte aquí.
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../components/portfolio/CaseHero.astro';
import FactBar from '../../components/portfolio/FactBar.astro';
import OutcomeTiles from '../../components/portfolio/OutcomeTiles.astro';
import Lightbox from '../../components/portfolio/Lightbox.astro';
import TestimonialQuote from '../../components/portfolio/TestimonialQuote.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../data/case-studies';
import { buildCaseSeo } from '../../data/case-seo';

import mobile from '../../assets/images/projects/paulinalopezescritora/paulina-mobile.png';
import featured from '../../assets/images/projects/paulinalopezescritora/paulina-featured.png';

const cs = getCaseStudy('paulina-lopez-escritora');
const seo = await buildCaseSeo(cs, 'es');
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="es" />
      <FactBar cs={cs} lang="es" />

      <!-- Narrativa editorial: una columna, ritmo de lectura -->
      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-3xl px-6 md:px-12">
          <div class="reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">El Desafío</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Convertir seguidores en suscriptores sin sacrificar la estética.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              El objetivo fue centralizar la presencia digital de la autora en un hub
              profesional que convirtiera seguidores en suscriptores. El reto principal:
              implementar una estética visual rica — partículas, efectos parallax,
              texturas — sin sacrificar la velocidad de carga necesaria para retener al
              tráfico móvil proveniente de redes sociales.
            </p>
          </div>
          <div class="mt-14 reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">La Solución</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Belleza estática, interactividad solo cuando hace falta.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Implementamos una arquitectura web a medida que prioriza el contenido
              estático ligero, cargando la interactividad solo cuando es necesaria. La
              experiencia se optimizó con animaciones de aparición progresiva y
              formularios de suscripción asíncronos, garantizando una navegación fluida y
              sin interrupciones para el lector — con el sistema de marketing y la base
              de datos bajo el control total de la autora.
            </p>
          </div>
        </div>
      </section>

      <!-- La obra: móvil protagonista (el tráfico viene de redes) -->
      <section class="pb-20 md:pb-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid gap-6 md:grid-cols-2">
            <button
              type="button"
              data-lightbox
              aria-label="Ampliar imagen"
              class="group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth"
            >
              <Image
                src={mobile}
                alt="paulinalopezescritora.com en móvil"
                widths={[720, 1600]}
                sizes="(max-width: 768px) 100vw, 550px"
                class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </button>
            <button
              type="button"
              data-lightbox
              aria-label="Ampliar imagen"
              class="group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth delay-150"
            >
              <Image
                src={featured}
                alt="Sección destacada del sitio de Paulina López"
                widths={[720, 1600]}
                sizes="(max-width: 768px) 100vw, 550px"
                class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </button>
          </div>
        </div>
      </section>

      <OutcomeTiles outcomes={cs.outcomes} lang="es" />

      <TestimonialQuote
        quote={'La velocidad de la página es increíble, pero lo que más valoro es la facilidad con la que ahora manejo mi marketing.\nEl sistema integrado me permite controlar todas mis campañas y automatizaciones con total autonomía, simplificando enormemente mi trabajo diario.'}
        author="Paulina L., Autora"
      />

      <CaseCta lang="es" />
      <Lightbox lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
