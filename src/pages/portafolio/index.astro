---
// Index del portafolio (ES) — showroom oscuro (BRAND.md / ADR-0002).
// Cards y filtros se derivan del registro central (ADR-0001): aquí no vive
// ningún hecho de un case study.
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseCard from '../../components/portfolio/CaseCard.astro';
import FilterBar from '../../components/portfolio/FilterBar.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import { caseStudies } from '../../data/case-studies';

const title = 'Portafolio | Hikevo Design';
const description =
  'Selección de proyectos de desarrollo web, sistemas a medida y estrategias digitales. Resultados reales para empresas reales.';
---

<MainLayout title={title} description={description}>
  <Header />

  <CaseTheme theme={{ mode: 'dark', accent: '#FFB919' }}>
    <main class="pt-32 pb-0">
      <section class="mb-14">
        <div class="mx-auto max-w-3xl px-6 text-center">
          <div class="animate-fade-in">
            <h1 class="font-display text-5xl font-bold tracking-tight md:text-7xl">
              Menos ruido, <br />
              <span class="text-pf-ink-soft">más impacto.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-pf-ink-soft">
              Una selección de nuestros proyectos favoritos. Diseñados para convertir y
              construidos para durar.
            </p>
          </div>
          <div class="mt-10 reveal-smooth delay-150">
            <FilterBar lang="es" />
          </div>
        </div>
      </section>

      <section class="pb-24">
        <div
          class="mx-auto grid max-w-7xl gap-x-6 gap-y-14 px-6 sm:grid-cols-2 md:px-12 lg:grid-cols-3 reveal-smooth delay-300"
          id="pf-grid"
        >
          {caseStudies.map((cs) => <CaseCard cs={cs} lang="es" />)}
        </div>
      </section>

      <CaseCta lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
