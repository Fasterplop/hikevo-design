---
// Case study: Fortitude Insurance (ES) — tipo redesign.
// Página libre (ADR-0001): los hechos vienen del registro; la prosa y el arte
// viven aquí. Receta "la obra primero" (BRAND.md).
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../components/portfolio/CaseHero.astro';
import FactBar from '../../components/portfolio/FactBar.astro';
import BeforeAfterSlider from '../../components/portfolio/BeforeAfterSlider.astro';
import OutcomeTiles from '../../components/portfolio/OutcomeTiles.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import Lightbox from '../../components/portfolio/Lightbox.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../data/case-studies';
import { buildCaseSeo } from '../../data/case-seo';

import after2 from '../../assets/images/projects/fortitude-insurance/desktop-2.png';
import after3 from '../../assets/images/projects/fortitude-insurance/desktop-3.png';
import after4 from '../../assets/images/projects/fortitude-insurance/desktop-4-hero.png';
import after5 from '../../assets/images/projects/fortitude-insurance/desktop-5.png';

const cs = getCaseStudy('fortitude-insurance');
if (cs.type !== 'redesign') throw new Error('fortitude-insurance debe ser type redesign');
const seo = await buildCaseSeo(cs, 'es');

// El hero de la página usa la captura "solo hero" (registro); la galería muestra
// el resto sin repetirla: modo oscuro como protagonista ancho + vistas interiores.
const gallery = [after4, after3, after5, after2];
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="es" />
      <FactBar cs={cs} lang="es" />

      <!-- El Desafío -->
      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="max-w-3xl reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">El Desafío</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Una agencia moderna atrapada en un sitio de 2010.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              {cs.before.summary.es}
            </p>
            <p class="mt-4 text-lg leading-relaxed text-pf-ink-soft">
              El mercado de Fortitude es mayoritariamente hispano, pero su web solo hablaba
              inglés. Cotizar una póliza, descargar un documento o iniciar un reclamo
              exigía llamar por teléfono en horario de oficina — fricción pura para un
              negocio que vive de la conversión de leads.
            </p>
          </div>
        </div>
      </section>

      <!-- El antes y el después: la prueba visual -->
      <section class="pb-20 md:pb-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="reveal-smooth">
            <BeforeAfterSlider
              before={cs.comparison.before}
              after={cs.comparison.after}
              altBefore="Página de inicio anterior de fortitudeins.us: plantilla estática en HTML"
              altAfter="Página de inicio rediseñada de fortitudeins.us: plataforma bilingüe moderna"
              lang="es"
            />
            <p class="mt-4 text-center font-mono text-xs text-pf-ink-soft">
              Desliza (o usa las flechas del teclado) para comparar la página de inicio.
            </p>
          </div>

          <!-- Tiles uniformes 3:2 (las páginas legacy tienen alturas muy
               distintas); la captura completa se abre en el Lightbox. -->
          <div class="mt-12 grid gap-6 md:grid-cols-3 reveal-smooth delay-150">
            {
              cs.before.screenshots.slice(1).map((shot) => (
                <button
                  type="button"
                  data-lightbox
                  aria-label="Ampliar imagen"
                  class="group cursor-pointer overflow-hidden rounded-xl border border-pf-line bg-pf-surface-2 text-left transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent"
                >
                  <span class="block aspect-[3/2] overflow-hidden">
                    <Image
                      src={shot}
                      alt="Página interior del sitio anterior de Fortitude Insurance"
                      widths={[720, 1600]}
                      sizes="(max-width: 768px) 100vw, 360px"
                      class="h-full w-full object-cover object-top opacity-80 transition-opacity group-hover:opacity-100"
                    />
                  </span>
                  <span class="block border-t border-pf-line px-4 py-2 font-mono text-[11px] uppercase tracking-widest text-pf-ink-soft">
                    Antes — sitio legacy
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <!-- La Solución -->
      <section class="border-t border-pf-line py-20 md:py-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="max-w-3xl reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">La Solución</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Una plataforma bilingüe que trabaja las 24 horas.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Reconstruimos fortitudeins.us desde cero con una arquitectura estática de
              alto rendimiento: experiencia espejo en inglés y español, modo claro y
              oscuro, y las herramientas del negocio integradas al sitio — el cotizador
              en tiempo real y el centro de cuentas para reclamos y documentos.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-pf-ink-soft">
              Los formularios llegan directo a la agencia vía Resend, y Cloudflare
              gestiona tráfico y seguridad. El cliente ahora cotiza, consulta y reclama
              solo, a cualquier hora — la agencia atiende, no tramita.
            </p>
          </div>
        </div>
      </section>

      <!-- La obra: el sitio nuevo en grande -->
      <section class="pb-20 md:pb-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid gap-6 md:grid-cols-3">
            {
              gallery.map((shot, i) => (
                <button
                  type="button"
                  data-lightbox
                  aria-label="Ampliar imagen"
                  class:list={[
                    'group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth',
                    i === 0 && 'md:col-span-3',
                    i === 2 && 'delay-150',
                    i === 3 && 'delay-300',
                  ]}
                >
                  <Image
                    src={shot}
                    alt={`Vista del nuevo sitio de Fortitude Insurance (${i + 1})`}
                    widths={[720, 1600]}
                    sizes={i === 0 ? '(max-width: 768px) 100vw, 1100px' : '(max-width: 768px) 100vw, 360px'}
                    class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <OutcomeTiles outcomes={cs.outcomes} lang="es" />

      <CaseCta lang="es" />
      <Lightbox lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
