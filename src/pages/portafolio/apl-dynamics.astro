---
// Case study: APL Dynamics (ES) — e-commerce con dos superficies.
// Página libre (ADR-0001): hechos del registro, prosa y arte aquí.
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import CaseTheme from '../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../components/portfolio/CaseHero.astro';
import FactBar from '../../components/portfolio/FactBar.astro';
import SurfaceChapter from '../../components/portfolio/SurfaceChapter.astro';
import OutcomeTiles from '../../components/portfolio/OutcomeTiles.astro';
import Lightbox from '../../components/portfolio/Lightbox.astro';
import CaseCta from '../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../data/case-studies';
import { buildCaseSeo } from '../../data/case-seo';

// Recorte "debajo del hero" del full-page: el hero ya lo muestra el CaseHero.
import storefront2 from '../../assets/images/projects/apl-dynamics/storefront-2-below.png';
import product from '../../assets/images/projects/apl-dynamics/product.png';
import admin from '../../assets/images/projects/apl-dynamics/admin.png';

const cs = getCaseStudy('apl-dynamics');
const seo = await buildCaseSeo(cs, 'es');
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="es" />
      <FactBar cs={cs} lang="es" />

      <!-- Desafío / Solución en dos columnas: relato técnico, tono industrial -->
      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid gap-16 md:grid-cols-2">
            <div class="reveal-smooth">
              <div class="mb-4 flex items-center gap-3">
                <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
                <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">El Desafío</p>
              </div>
              <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
                Vender hardware de 100 kilos como si fuera un clic.
              </h2>
              <p class="mt-6 leading-relaxed text-pf-ink-soft">
                APL Dynamics fabrica asientos y hardware estructural para simuladores de
                vuelo: productos raros, pesados y de alto valor, que se vendían por
                correo y cotización manual. Cada venta exigía calcular flete de carga,
                impuestos por estado y coordinar fabricación bajo pedido.
              </p>
              <p class="mt-4 leading-relaxed text-pf-ink-soft">
                El reto: que un cliente en cualquier punto de EE. UU. pudiera explorar el
                catálogo, conocer cada pieza en detalle y pagar en línea — sin crear una
                cuenta y sin una sola llamada.
              </p>
            </div>
            <div class="reveal-smooth delay-150">
              <div class="mb-4 flex items-center gap-3">
                <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
                <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">La Solución</p>
              </div>
              <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
                Checkout de invitado con flete de carga en tiempo real.
              </h2>
              <p class="mt-6 leading-relaxed text-pf-ink-soft">
                Construimos un e-commerce a medida donde el flete se cotiza en vivo con
                la tarifa preferencial de Estes Express — entrega a muelle comercial o
                residencial con plataforma elevadora — y los impuestos se calculan solos
                según el estado de destino. El pago corre por Stripe.
              </p>
              <p class="mt-4 leading-relaxed text-pf-ink-soft">
                Los productos totalmente personalizados no van al carrito: el sistema
                dirige al cliente a un formulario de cotización que llega directo al
                correo del fabricante. Todo lo demás se compra solo.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Superficie 1: Storefront -->
      <SurfaceChapter surface={cs.surfaces![0]} index={1} lang="es">
        <div class="grid gap-6 md:grid-cols-2">
          <button
            type="button"
            data-lightbox
            aria-label="Ampliar imagen"
            class="group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth"
          >
            <Image
              src={storefront2}
              alt="Presentación del estudio en el storefront de APL Dynamics"
              widths={[720, 1600]}
              sizes="(max-width: 768px) 100vw, 550px"
              class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </button>
          <button
            type="button"
            data-lightbox
            aria-label="Ampliar imagen"
            class="group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth delay-150"
          >
            <Image
              src={product}
              alt="Página de producto con galería, especificaciones y disponibilidad"
              widths={[720, 1600]}
              sizes="(max-width: 768px) 100vw, 550px"
              class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </button>
        </div>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          Galería en alta resolución con zoom, video embebido, especificaciones físicas y
          tiempo estimado de fabricación por producto — con el aviso legal "Not for real
          flight operations" siempre visible.
        </p>
      </SurfaceChapter>

      <!-- Superficie 2: Panel de administración -->
      <SurfaceChapter surface={cs.surfaces![1]} index={2} lang="es">
        <button
          type="button"
          data-lightbox
          aria-label="Ampliar imagen"
          class="group block w-full cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth"
        >
          <Image
            src={admin}
            alt="Panel de administración: productos, pedidos y clientes"
            widths={[720, 1600]}
            sizes="(max-width: 768px) 100vw, 1100px"
            class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </button>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          El fabricante gestiona catálogo, categorías, pedidos y reembolsos sin ayuda
          técnica. Registrar un número de rastreo dispara automáticamente el correo de
          seguimiento al cliente.
        </p>
      </SurfaceChapter>

      <OutcomeTiles outcomes={cs.outcomes} lang="es" />

      <CaseCta lang="es" />
      <Lightbox lang="es" />
    </main>
  </CaseTheme>
</MainLayout>
