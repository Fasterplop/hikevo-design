---
// Case study: Lucky Pet Tag (EN) — 3-surface ecosystem.
// Free page (ADR-0001): facts from the registry, prose and art live here.
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/common/Header.astro';
import CaseTheme from '../../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../../components/portfolio/CaseHero.astro';
import FactBar from '../../../components/portfolio/FactBar.astro';
import AnchorChips from '../../../components/portfolio/AnchorChips.astro';
import SurfaceChapter from '../../../components/portfolio/SurfaceChapter.astro';
import OutcomeTiles from '../../../components/portfolio/OutcomeTiles.astro';
import CaseCta from '../../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../../data/case-studies';
import { buildCaseSeo } from '../../../data/case-seo';

import publicProfile from '../../../assets/images/projects/lucky-pet-tag/public-profile.png';
import ownerPortal from '../../../assets/images/projects/lucky-pet-tag/owner-portal.png';
import admin1 from '../../../assets/images/projects/lucky-pet-tag/admin-1.png';
import admin2 from '../../../assets/images/projects/lucky-pet-tag/admin-2.png';

const cs = getCaseStudy('lucky-pet-tag');
const seo = await buildCaseSeo(cs, 'en');
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="en" />
      <FactBar cs={cs} lang="en" />
      <div class="pt-10">
        <AnchorChips surfaces={cs.surfaces} lang="en" />
      </div>

      <!-- Narrative: single column, story tone -->
      <section class="py-16 md:py-24">
        <div class="mx-auto max-w-3xl px-6 md:px-12">
          <div class="reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">The Challenge</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              A QR tag is only worth it if the profile behind it builds itself.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              Lucky Pet Tag sells QR-coded tags on their Shopify store. The problem was
              everything after the purchase: creating each pet's profile, guaranteeing
              only the legitimate owner could edit it, and serving an instant public view
              when someone scans the tag of a lost pet.
            </p>
          </div>
          <div class="mt-14 reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">The Solution</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Every purchase generates its profile. Nobody touches anything.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              We connected Shopify orders to a dedicated three-surface ecosystem: each
              purchase triggers the unique ID, the pet's profile and its QR code —
              generated by the system itself, ready for the Lucky Pet Tag team to print
              the tag. The owner authenticates with their purchase email to manage the
              profile, and scanning the QR opens a public view optimized for the
              finder's phone — with direct WhatsApp to the owner and one-tap location
              sharing.
            </p>
          </div>
        </div>
      </section>

      <!-- Surface 1: Public QR view (vertical phone image) -->
      <SurfaceChapter surface={cs.surfaces![0]} index={1} lang="en">
        <div class="grid items-center gap-10 md:grid-cols-5">
          <figure class="mx-auto w-full max-w-[300px] overflow-hidden rounded-3xl border border-pf-line bg-pf-surface-2 shadow-xl md:col-span-2 reveal-smooth">
            <Image
              src={publicProfile}
              alt="Public pet profile view after scanning the QR tag"
              widths={[360, 600]}
              sizes="300px"
              class="h-auto w-full"
            />
          </figure>
          <div class="md:col-span-3 reveal-smooth delay-150">
            <p class="text-lg leading-relaxed text-pf-ink-soft">
              Read-only, instant loading and designed for a stressful moment: pet name,
              description, a WhatsApp button to the owner and one-tap current-location
              sharing. No apps, no signup for the person who scans.
            </p>
          </div>
        </div>
      </SurfaceChapter>

      <!-- Surface 2: Owner portal -->
      <SurfaceChapter surface={cs.surfaces![1]} index={2} lang="en">
        <figure class="overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg reveal-smooth">
          <Image
            src={ownerPortal}
            alt="Private owner portal to manage the pet profile"
            widths={[720, 1400]}
            sizes="(max-width: 768px) 100vw, 1100px"
            class="h-auto w-full"
          />
        </figure>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          Secure login tied to the purchase email. The owner updates photo, description,
          contact and address — the visual identity mirrors the store exactly so it all
          feels like one product.
        </p>
      </SurfaceChapter>

      <!-- Surface 3: Admin dashboard -->
      <SurfaceChapter surface={cs.surfaces![2]} index={3} lang="en">
        <div class="grid gap-6 md:grid-cols-2">
          <figure class="overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg reveal-smooth">
            <Image
              src={admin1}
              alt="Admin dashboard: customers and pets listing"
              widths={[600, 1000]}
              sizes="(max-width: 768px) 100vw, 550px"
              class="h-auto w-full"
            />
          </figure>
          <figure class="overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg reveal-smooth delay-150">
            <Image
              src={admin2}
              alt="Admin dashboard: support tools and access control"
              widths={[600, 1000]}
              sizes="(max-width: 768px) 100vw, 550px"
              class="h-auto w-full"
            />
          </figure>
        </div>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          Full control of the system: customer and pet database, email invitations for
          approved collaborators, and every tag's QR code generated automatically —
          ready to download and print, with a record of which ones are already printed.
        </p>
      </SurfaceChapter>

      <OutcomeTiles outcomes={cs.outcomes} lang="en" />

      <CaseCta lang="en" />
    </main>
  </CaseTheme>
</MainLayout>
