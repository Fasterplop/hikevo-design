---
// Case study: Anis Barbara (EN) — social media, dark brand atmosphere.
// Free page (ADR-0001): facts from the registry, prose and art live here.
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/common/Header.astro';
import CaseTheme from '../../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../../components/portfolio/CaseHero.astro';
import FactBar from '../../../components/portfolio/FactBar.astro';
import TestimonialQuote from '../../../components/portfolio/TestimonialQuote.astro';
import Lightbox from '../../../components/portfolio/Lightbox.astro';
import CaseCta from '../../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../../data/case-studies';
import { buildCaseSeo } from '../../../data/case-seo';

import mobile from '../../../assets/images/projects/anis-barbara/anisbarbara-mobile.png';
import featured from '../../../assets/images/projects/anis-barbara/anisbarbara-featured.png';

const cs = getCaseStudy('anis-barbara');
const seo = await buildCaseSeo(cs, 'en');

// The full desktop feed is the hero (cardImage); here go the two square
// pieces — same ratio, aligned row with no cropping.
const feed = [
  { src: mobile, alt: 'Anis Barbara lifestyle content on Instagram' },
  { src: featured, alt: 'Featured brand piece' },
];
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="en" />
      <FactBar cs={cs} lang="en" />

      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-3xl px-6 md:px-12">
          <div class="reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">The Challenge</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              Selling a proprietary drink with nothing but a feed.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              The challenge was to sell a proprietary alcoholic beverage exclusively
              through Instagram. The visual content alone had to generate the trust and
              desire needed for a follower to order their bottle and close the purchase
              via direct message.
            </p>
          </div>
          <div class="mt-14 reveal-smooth">
            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
              <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">The Solution</p>
            </div>
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
              The feed as catalog, showcase and sales channel.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-pf-ink-soft">
              We transformed the profile into a complete brand experience: lifestyle
              content that ties the drink to moments of celebration and status, plus
              community management to keep the presence active. The feed does the selling
              — catalog, showcase and customer service in one.
            </p>
          </div>
        </div>
      </section>

      <!-- The content: pieces on a dark canvas, the bottle shines -->
      <section class="pb-20 md:pb-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {
              feed.map((f, i) => (
                <button
                  type="button"
                  data-lightbox
                  aria-label="View image larger"
                  class:list={[
                    'group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-xl transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth',
                    i === 1 && 'delay-150',
                  ]}
                >
                  <Image
                    src={f.src}
                    alt={f.alt}
                    widths={[720, 1600]}
                    sizes="(max-width: 640px) 100vw, 550px"
                    class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <TestimonialQuote
        quote={'My Instagram now looks incredible and professional.\nYou managed to capture the essence of my brand and thanks to that I\'ve had many orders via DM.'}
        author="Barbara S., Founder"
      />

      <CaseCta lang="en" />
      <Lightbox lang="en" />
    </main>
  </CaseTheme>
</MainLayout>
