---
// Portfolio index (EN) — dark showroom (BRAND.md / ADR-0002).
// Cards and filters derive from the central registry (ADR-0001): no case study
// facts live here.
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/common/Header.astro';
import CaseTheme from '../../../components/portfolio/CaseTheme.astro';
import CaseCard from '../../../components/portfolio/CaseCard.astro';
import FilterBar from '../../../components/portfolio/FilterBar.astro';
import CaseCta from '../../../components/portfolio/CaseCta.astro';
import { caseStudies } from '../../../data/case-studies';

const title = 'Portfolio | Hikevo Design';
const description =
  'A selection of web development, custom systems and digital strategy projects. Real results for real businesses.';
---

<MainLayout title={title} description={description}>
  <Header />

  <CaseTheme theme={{ mode: 'dark', accent: '#FFB919' }}>
    <main class="pt-32 pb-0">
      <section class="mb-14">
        <div class="mx-auto max-w-3xl px-6 text-center">
          <div class="animate-fade-in">
            <h1 class="font-display text-5xl font-bold tracking-tight md:text-7xl">
              Less noise, <br />
              <span class="text-pf-ink-soft">more impact.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-pf-ink-soft">
              A selection of our favorite projects. Designed to convert and built to last.
            </p>
          </div>
          <div class="mt-10 reveal-smooth delay-150">
            <FilterBar lang="en" />
          </div>
        </div>
      </section>

      <section class="pb-24">
        <div
          class="mx-auto grid max-w-7xl gap-x-6 gap-y-14 px-6 sm:grid-cols-2 md:px-12 lg:grid-cols-3 reveal-smooth delay-300"
          id="pf-grid"
        >
          {caseStudies.map((cs) => <CaseCard cs={cs} lang="en" />)}
        </div>
      </section>

      <CaseCta lang="en" />
    </main>
  </CaseTheme>
</MainLayout>
