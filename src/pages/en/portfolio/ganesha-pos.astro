---
// Case study: Ganesha POS (EN) — internal system, single private surface.
// Free page (ADR-0001): facts from the registry, prose and art live here.
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/common/Header.astro';
import CaseTheme from '../../../components/portfolio/CaseTheme.astro';
import CaseHero from '../../../components/portfolio/CaseHero.astro';
import FactBar from '../../../components/portfolio/FactBar.astro';
import SurfaceChapter from '../../../components/portfolio/SurfaceChapter.astro';
import OutcomeTiles from '../../../components/portfolio/OutcomeTiles.astro';
import Lightbox from '../../../components/portfolio/Lightbox.astro';
import CaseCta from '../../../components/portfolio/CaseCta.astro';
import { Image } from 'astro:assets';
import { getCaseStudy } from '../../../data/case-studies';
import { buildCaseSeo } from '../../../data/case-seo';

import dash2 from '../../../assets/images/projects/ganesha-pos/dashboard-2.png';
import dash3 from '../../../assets/images/projects/ganesha-pos/dashboard-3.png';
import dash4 from '../../../assets/images/projects/ganesha-pos/dashboard-4.png';
import dash5 from '../../../assets/images/projects/ganesha-pos/dashboard-5.png';

const cs = getCaseStudy('ganesha-pos');
const seo = await buildCaseSeo(cs, 'en');

const bento = [dash2, dash3, dash4, dash5];
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <script type="application/ld+json" set:html={seo.breadcrumbSchema} slot="head" />

  <Header />

  <CaseTheme theme={cs.theme}>
    <main>
      <CaseHero cs={cs} lang="en" />
      <FactBar cs={cs} lang="en" />

      <!-- Stacked narrative with emphasis on the replacement -->
      <section class="py-20 md:py-28">
        <div class="mx-auto max-w-6xl px-6 md:px-12">
          <div class="grid gap-16 md:grid-cols-2">
            <div class="reveal-smooth">
              <div class="mb-4 flex items-center gap-3">
                <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
                <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">The Challenge</p>
              </div>
              <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
                Generic software was too big and too small at the same time.
              </h2>
              <p class="mt-6 leading-relaxed text-pf-ink-soft">
                The toys-and-clothing store ran on commercial POS software that didn't
                speak its language: no manual payment methods like Zelle or Pago Móvil,
                no customer registry by national ID, and none of the operation that ate
                the most time — creating on-the-fly discounts and labeling them
                instantly.
              </p>
            </div>
            <div class="reveal-smooth delay-150">
              <div class="mb-4 flex items-center gap-3">
                <span class="h-px w-10 bg-pf-accent" aria-hidden="true"></span>
                <p class="font-mono text-xs uppercase tracking-widest text-pf-accent">The Solution</p>
              </div>
              <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
                A POS that works exactly how the store works.
              </h2>
              <p class="mt-6 leading-relaxed text-pf-ink-soft">
                A custom web system with two roles: the owner sees the whole business —
                sales by day/week/month, cash flow by payment method, top customers —
                while cashiers get a clean interface focused on charging. Hot discount
                codes with thermal label printing, and an API-first database ready for
                the loyalty program and mobile app on the roadmap.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- The surface: POS dashboard bento -->
      <SurfaceChapter surface={cs.surfaces![0]} index={1} lang="en">
        <div class="grid gap-6 md:grid-cols-2">
          {
            bento.map((shot, i) => (
              <button
                type="button"
                data-lightbox
                aria-label="View image larger"
                class:list={[
                  'group cursor-pointer overflow-hidden rounded-2xl border border-pf-line bg-pf-surface-2 shadow-lg transition-colors hover:border-pf-accent focus-visible:outline-2 focus-visible:outline-pf-accent reveal-smooth',
                  i % 2 === 1 && 'delay-150',
                ]}
              >
                <Image
                  src={shot}
                  alt={`Ganesha POS dashboard (${i + 1}): sales, inventory and stats`}
                  widths={[720, 1600]}
                  sizes="(max-width: 768px) 100vw, 550px"
                  class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
                />
              </button>
            ))
          }
        </div>
        <p class="mt-6 max-w-2xl text-pf-ink-soft reveal-smooth">
          Owner dashboard, cashier point-of-sale, categorized inventory and a basic CRM
          by national ID with purchase history — all in the browser, nothing to install.
        </p>
      </SurfaceChapter>

      <OutcomeTiles outcomes={cs.outcomes} lang="en" />

      <CaseCta lang="en" />
      <Lightbox lang="en" />
    </main>
  </CaseTheme>
</MainLayout>
