---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/common/Header.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/common/Button.astro';
import heroBg from '../../assets/images/snow-mountain.jpg';
import { Image } from 'astro:assets';

import { getCaseStudy } from '../../data/case-studies';

// Home featured cases: title, services and image come from the central
// registry (ADR-0001) — the cover is the same portfolio card.
const featured = [
  'fortitude-insurance',
  'apl-dynamics',
  'mister-mango',
  'ganesha-pos',
  'globo-care-remodeling',
  'paulina-lopez-escritora',
].map(getCaseStudy);

// Metadatos traducidos
const title = "Hikevo Design | Web Development & Digital Strategy";
const description = "Digital agency specialized in high-performance web design and social media management.";
---

<MainLayout title={title} description={description}>
  <Header />

  <main>
    <section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden min-h-[90vh] flex items-center">
      
      <div class="absolute inset-0 z-0">
        <Image 
          src={heroBg} 
          alt="Mountains and team looking at the horizon" 
          class="w-full h-full object-cover"
          quality="mid"
          loading="eager" 
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-hikevo-black via-hikevo-black/80 to-hikevo-black/50"></div>
      </div>

      <Container class="relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          
          <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-[1.1] reveal-smooth">
            Take your business <br class="hidden md:block" />to the top.
          </h1>
          
          <p class="text-lg md:text-xl text-gray-200 mb-10 max-w-2xl mx-auto leading-relaxed reveal-smooth delay-150">
            We design your corporate website and manage your social media so you can focus solely on running your business.
            No technical jargon, total transparency.
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal-smooth delay-300">
            <div class="transition-transform duration-500 ease-out hover:scale-105">
                <Button href="/en/solutions" variant="primary">
                View Solutions and Pricing
              </Button>
            </div>
            <div class="transition-transform duration-500 ease-out hover:scale-105">
                <Button href="https://wa.me/17866692775?text=Hello!%20I%20would%20like%20to%20talk%20about%20improving%20my%20business." variant="outline" isExternal={true} class="text-white border-white hover:bg-white hover:text-black">
                Request Free Web Analysis
                </Button>
            </div>
          </div>

        </div>
      </Container>
    </section>

    <section class="py-24 bg-hikevo-gray-light">
      <Container>
        <h2 class="sr-only">Our Services</h2>
        <div class="grid md:grid-cols-3 gap-8">
            <article class="reveal-smooth bg-white p-8 rounded-2xl shadow-sm border border-gray-100 transition-all duration-500 ease-out hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02]">
                <div class="w-12 h-12 bg-hikevo-yellow/10 rounded-xl flex items-center justify-center mb-6 text-hikevo-yellow transition-transform duration-500 ease-out hover:rotate-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Premium Web Development</h3>
                <p class="text-hikevo-charcoal/70 mb-4 text-sm leading-relaxed">Ultra-fast corporate sites custom-made.
                Optimized for Google and designed to convert.</p>
            </article>

             <article class="reveal-smooth delay-150 hover:delay-0 bg-white p-8 rounded-2xl shadow-sm border border-gray-100 transition-all duration-500 ease-out hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02]">
                <div class="w-12 h-12 bg-hikevo-yellow/10 rounded-xl flex items-center justify-center mb-6 text-hikevo-yellow transition-transform duration-500 ease-out hover:-rotate-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Content & Ads</h3>
                <p class="text-hikevo-charcoal/70 mb-4 text-sm leading-relaxed">We manage your social media and ad campaigns.
                We create the content and bring you qualified traffic.</p>
            </article>

             <article class="reveal-smooth delay-300 hover:delay-0 bg-white p-8 rounded-2xl shadow-sm border border-gray-100 transition-all duration-500 ease-out hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02]">
                <div class="w-12 h-12 bg-hikevo-yellow/10 rounded-xl flex items-center justify-center mb-6 text-hikevo-yellow transition-transform duration-500 ease-out hover:rotate-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Technical Maintenance</h3>
                <p class="text-hikevo-charcoal/70 mb-4 text-sm leading-relaxed">We handle updates and security.
                Your website will always be active and functional.</p>
            </article>
        </div>
        
        <div class="text-center mt-12 reveal-smooth">
            <Button href="/en/solutions" variant="text" class="group transition-all duration-300 hover:tracking-wide">
                Explore all packages 
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-2">&rarr;</span>
            </Button>
        </div>
      </Container>
    </section>

    <section class="py-24">
      <Container>
        <div class="mb-16 md:text-center max-w-3xl mx-auto reveal-smooth">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-hikevo-black">Results that speak.</h2>
          <p class="text-lg text-hikevo-charcoal/70">Less noise, more clarity. This is how we help our clients.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          {
            featured.map((cs, i) => (
              <article
                class:list={[
                  'group cursor-pointer reveal-smooth',
                  i % 3 === 1 && 'delay-150',
                  i % 3 === 2 && 'delay-300',
                ]}
              >
                <a
                  href={`/en/portfolio/${cs.slug}`}
                  class="block bg-gray-100 rounded-2xl aspect-[16/10] mb-6 overflow-hidden relative border border-gray-100"
                  transition:name={`pf-${cs.slug}`}
                >
                  <Image
                    src={cs.cardImage}
                    alt={`${cs.title} — ${cs.services.en}`}
                    class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 420px"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500" />
                </a>
                <h3 class="text-xl font-bold mb-1 group-hover:text-hikevo-yellow transition-colors duration-300">
                  {cs.title}
                </h3>
                <p class="text-sm text-hikevo-gray font-medium mb-3">{cs.services.en}</p>
                <a
                  href={`/en/portfolio/${cs.slug}`}
                  class="text-sm font-semibold underline decoration-2 decoration-hikevo-yellow underline-offset-4 group-hover:text-hikevo-yellow transition-colors duration-300"
                >
                  View Case
                </a>
              </article>
            ))
          }
        </div>

        <div class="text-center reveal-smooth">
            <div class="inline-block transition-transform duration-500 ease-out hover:scale-105">
                <Button href="/en/portfolio" variant="outline">
                    View Full Portfolio
                </Button>
           </div>
        </div>
      </Container>
    </section>

    <section class="py-24 bg-hikevo-gray-light">
      <Container>
         <div class="grid md:grid-cols-3 gap-12">
            <div class="reveal-smooth group">
               <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-hikevo-yellow transition-transform duration-500 group-hover:scale-150"></span> Honesty Above All
               </h3>
               <p class="text-hikevo-charcoal/80 text-sm leading-relaxed">
                   We won't sell you smoke or services you don't need. We prefer earning your trust rather than inflating a budget.
               </p>
            </div>

            <div class="reveal-smooth delay-150 group">
               <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-hikevo-yellow transition-transform duration-500 group-hover:scale-150"></span> Performance Obsession
               </h3>
               <p class="text-hikevo-charcoal/80 text-sm leading-relaxed">
                  We don't use slow templates. We build with modern technologies that Google loves.
               </p>
            </div>

            <div class="reveal-smooth delay-300 group">
               <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-hikevo-yellow transition-transform duration-500 group-hover:scale-150"></span> Your Technical Ally
               </h3>
               <p class="text-hikevo-charcoal/80 text-sm leading-relaxed">
                  If the web or networks fail, we solve it before you even worry.
               </p>
            </div>
         </div>
      </Container>
    </section>

    <section class="py-24 bg-hikevo-black text-white">
        <Container>
            <div class="max-w-3xl mx-auto text-center reveal-smooth">
                <h2 class="text-3xl md:text-5xl font-bold mb-6">Ready to digitize your business?</h2>
                <p class="text-gray-300 mb-10 text-lg">Start with a quick audit of your current situation, totally free.</p>
                
                <div class="flex flex-col items-center gap-4">
                     <div class="transition-transform duration-500 ease-out hover:scale-105">
                        <Button
                          href="https://wa.me/17866692775?text=Hello!%20I%20would%20like%20to%20talk%20about%20improving%20my%20business."
                          variant="primary"
                          isExternal={true}
                        >
                            Chat on WhatsApp
                        </Button>
                     </div>
                    <span class="text-xs text-gray-500">We reply in less than 24 hours.</span>
                </div>
            </div>
        </Container>
    </section>
  </main>
</MainLayout>